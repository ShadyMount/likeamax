{
    "name": "telegram-green-chat",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "npm run test:types && npm run test:unit && npm run test:browser",
        "test:browser": "npm run build && node tests/smoke.mjs",
        "test:unit": "node --test tests/unit/*.test.mjs",
        "test:types": "tsc --project tsconfig.type-tests.json",
        "lint:code": "eslint . --max-warnings 0",
        "lint:fsd": "steiger ./src",
        "lint": "npm run lint:code && npm run lint:fsd",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run lint && npm run format:check && npm test"
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "5.7.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@feature-sliced/steiger-plugin": "0.8.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "playwright": "1.64.1",
        "prettier": "3.9.10",
        "steiger": "0.8.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5"
    }
}
